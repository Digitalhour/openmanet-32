menu "hopnode"

    config HOP_MESH_ID
        string "Mesh name (802.11s Mesh ID)"
        default "OpenMANET-XIAO"

    config HOP_MESH_PASSWORD
        string "Mesh password (SAE); leave empty for an open mesh"
        default ""
        help
            Set the same password on every node, including the Linux ones (the OpenWrt
            mesh "key" with encryption sae). Up to 63 characters. Never printed.

    config HOP_S1G_CHANNEL
        int "HaLow channel (S1G channel number)"
        range 1 51
        default 26

    config HOP_S1G_OPCLASS
        int "HaLow operating class"
        range 68 71
        default 69

    config HOP_PRI_BW_MHZ
        int "Primary channel width in MHz (0 = default)"
        range 0 2
        default 0
        help
            Must match the Linux nodes: OpenMANET's s1g_prim_chwidth=1 means 2 MHz.

    config HOP_PRI_1MHZ_IDX
        int "Primary 1 MHz channel index inside the channel"
        range 0 7
        default 0
        help
            Must match the Linux nodes' s1g_prim_1mhz_chan_index.

    config HOP_BEACON_TUS
        int "Beacon interval in TU (0 = default)"
        range 0 10000
        default 0
        help
            OpenMANET uses 1000.

    config HOP_TX_DBM
        int "Cap HaLow TX power (dBm, 0 = regulatory maximum)"
        range 0 30
        default 8

    config HOP_BAT_SUBNET
        string "bat0 subnet (the node takes .<last byte of its bat address>)"
        default "10.41.250.0"

    config HOP_BAT_MASK
        string "bat0 netmask"
        default "255.255.0.0"

    config HOP_PING_PEERS
        bool "Ping every known bat0 node over the mesh every 5 s and log the result"
        default y

    config HOP_HALOW_SPI_MAX_HZ
        int "Cap the HaLow SPI clock (Hz)"
        range 1000000 50000000
        default 40000000

    config HOP_HALOW_RESET_HOLD_MS
        int "Hold the HaLow chip in reset this long (ms)"
        range 5 20000
        default 8000

    config HOP_HALOW_RESET_SETTLE_MS
        int "HaLow chip boot time after reset (ms)"
        range 20 2000
        default 250

    config HOP_AP_SSID
        string "Hotspot name (empty: Meshpoint- and the last MAC bytes)"
        default ""
        help
            The 2.4 GHz hotspot phones and laptops join to reach the mesh and the settings
            page. The page can change it; this is the value before anything is saved there.

    config HOP_AP_PASSWORD
        string "Hotspot password (WPA2, 8 to 63 characters)"
        default "meshpoint"
        help
            Starting value only: change it on the settings page. Never printed.

    config HOP_AP_CHANNEL
        int "Hotspot 2.4 GHz channel"
        range 1 13
        default 6

    config HOP_AP_TX_DBM
        int "Hotspot transmit power cap (dBm)"
        range 2 20
        default 11
        help
            Kept low by default: the 2.4 GHz radio's current peaks add to the HaLow radio's
            on the same USB supply.

    config HOP_AP_IP
        string "Hotspot address (a /24; the settings page lives here)"
        default "192.168.4.1"

endmenu
